rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Skill test connection validation path
    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? getUserData().role : "patient";
    }

    function isAdmin() {
      return (isSignedIn() && (
        request.auth.token.email == "yadasomesh46@gmail.com" ||
        request.auth.token.email == "admin@smartcare.cloud" ||
        getUserRole() == "admin"
      ));
    }

    // Users collection: user profiles and credentials
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isAdmin();
    }

    // Patients collection: patient clinical demographics
    match /patients/{patientId} {
      allow read: if true;
      allow create, update: if isValidId(patientId);
      allow delete: if isAdmin();
    }

    // Doctors collection: physician registry and schedules
    match /doctors/{doctorId} {
      allow read: if true;
      allow create, update: if isValidId(doctorId);
      allow delete: if isAdmin();
    }

    // Appointments collection: scheduling visits
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create, update: if isValidId(appointmentId);
      allow delete: if isAdmin();
    }

    // Medical Records collection: clinical records and prescriptions
    match /medicalRecords/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId);
      allow delete: if isAdmin();
    }
  }
}

