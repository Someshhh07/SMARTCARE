# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Cloud Platform Configuration (Academic Prototype)
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="smartcare-cloud-academic.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="smartcare-cloud-academic"
VITE_FIREBASE_STORAGE_BUCKET="smartcare-cloud-academic.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="105732662225"
VITE_FIREBASE_APP_ID="1:105732662225:web:smartcarecloud"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Server-Side Firebase Admin & Cloud Architecture
FIREBASE_SERVICE_ACCOUNT_KEY=""
PORT=3000
NODE_ENV="development"

